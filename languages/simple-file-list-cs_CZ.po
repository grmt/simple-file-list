msgid "Admin Tools"
msgstr "Nástroje pro správu"

#: includes/ee-admin-tools.php:43
msgid "Simple File List Tools Plugin"
msgstr "Plugin pro jednoduchý seznam souborů"

#: includes/ee-admin-tools.php:47
